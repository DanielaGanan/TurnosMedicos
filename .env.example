# Copiá este archivo a .env y completá tus credenciales
# En Windows PowerShell podés crear la variable con:
#   setx DATABASE_URL "mysql+aiomysql://usuario:password@127.0.0.1:3306/turno_medico"

# URL de conexión a la base de datos (driver async aiomysql)
DATABASE_URL=mysql+aiomysql://usuario:password@127.0.0.1:3306/turno_medico

